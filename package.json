{
  "name": "only-core",
  "version": "1.0.0",
  "description": "A zero-dependency, TypeScript-first policy execution engine for enforcing preconditions before executing business actions.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:stress": "vitest run test/stress",
    "benchmark": "npm run build && node benchmarks/policy.mjs",
    "benchmark:memory": "npm run build && node --expose-gc benchmarks/memory.mjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "policy",
    "enforcement",
    "guards",
    "preconditions",
    "typescript",
    "zero-dependency",
    "execution-engine",
    "business-rules"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.14.1",
    "typescript": "^5.8.3",
    "vite": "^8.3.1",
    "vitest": "^3.1.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
